# saypipe: run `waypipe [-n] -c zstd ssh <host> <command...>`
#
#   CLI:       saypipe <host> [<command...>]
#   Via link:  saypipe --link-add myserver; myserver [<command...>]
#
# Launches run detached, so closing the terminal doesn't close the app. A
# launch that fails right away (ssh error, command not found) is reported in
# the terminal; failures are also appended to ~/.local/state/saypipe/errors.log.
#
# Waypipe options, per host:
#   default      -n -c zstd   -n (--no-gpu) sends shm buffers, no dmabufs. Hosts
#                             without a GPU need it: there waypipe-server aborts
#                             with "Failed to create Vulkan instance".
#   GPU opt-in   -c zstd      hosts listed in ~/.config/saypipe/gpu-hosts
#                             (one per line, # comments). Lets GL apps share
#                             dmabufs.
#   -c zstd uses ~30% less bandwidth than the default lz4 at the same frame rate.
#   SAYPIPE_OPTS="..." (word-split) replaces the options for every host.
#
# Audio opt-in: for hosts listed in ~/.config/saypipe/audio-hosts, the local
# PulseAudio socket is forwarded over the same ssh connection (ssh -R to a
# random /tmp/saypipe-pulse-*.sock on the remote) and the app is started as
# `env PULSE_SERVER=unix:<that socket> <command...>`. The remote socket is
# removed again after the session.
#
# Connection sharing opt-in: hosts listed in ~/.config/saypipe/share-hosts get
# ssh -o ControlMaster=auto (control sockets in $XDG_RUNTIME_DIR/saypipe/cm,
# kept for SAYPIPE_SHARE_PERSIST, default 10m), so every session to the host
# reuses one connection.
#
# Host links (--link-add) go in $SAYPIPE_BIN_DIR, default ~/.local/bin. Install
# and uninstall with install.sh.
#
# A private remote D-Bus session, when dbus-run-session is available, lets
# portal services inherit this launch's Wayland display instead of using the
# shared user service environment. Hosts without it keep the normal session bus.
#
# Needs bash (4.4 or newer), OpenSSH and waypipe; otherwise only POSIX tools.

# Keep this guard parseable by Bash 3, before any newer syntax executes.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
    echo 'saypipe: Bash 4.4 or newer is required' >&2
    exit 1
fi
set -u
VERSION=0.1.0

SELF=saypipe          # canonical name; any other name is treated as the host
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/saypipe"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/saypipe"
GPU_HOSTS_FILE="$CONFIG_DIR/gpu-hosts"
AUDIO_HOSTS_FILE="$CONFIG_DIR/audio-hosts"
SHARE_HOSTS_FILE="$CONFIG_DIR/share-hosts"
ALIASES_FILE="$CONFIG_DIR/aliases"
COMMANDS_FILE="$CONFIG_DIR/commands"
HOSTS_FILE="$CONFIG_DIR/hosts"
SETTINGS_FILE="$CONFIG_DIR/settings"
SHARE_RUNTIME=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/saypipe-$(id -u)}
SHARE_DIR="$SHARE_RUNTIME/saypipe/cm"
ERROR_LOG="$STATE_DIR/errors.log"

name=${0##*/}
name=${name%.sh}
host=
[ "$name" != "$SELF" ] && host=$name

FORCE=0               # --force: enable hosts without checking for waypipe
mgmt_rc=0             # exit status of management commands
LINKS_MADE=0          # a link was created (for the PATH note)

# resolve <path>: absolute path with all symlinks resolved (readlink -f where
# available, else realpath, else a manual walk).
resolve() {
    local p=$1 d l n=0
    if readlink -f -- / >/dev/null 2>&1; then
        readlink -f -- "$p" 2>/dev/null && return
    fi
    if command -v realpath >/dev/null 2>&1; then realpath -- "$p" 2>/dev/null && return; fi
    while [ -L "$p" ] && [ $n -lt 40 ]; do
        l=$(readlink -- "$p") || break
        case $l in /*) p=$l ;; *) p=${p%/*}/$l ;; esac
        n=$((n + 1))
    done
    [ ! -L "$p" ] || return 1
    d=$(cd -P -- "$(dirname -- "$p")" 2>/dev/null && pwd -P) || return 1
    printf '%s/%s\n' "$d" "${p##*/}"
}

# die_soft <message>: report a failure for one item and carry on (exit 1 later).
die_soft() { printf '%s: %s\n' "$SELF" "$*" >&2; mgmt_rc=1; }

# usage_error <message>: wrong arguments; exit 2.
usage_error() {
    printf '%s: %s\n' "$SELF" "$*" >&2
    printf "Try '%s --help'.\n" "$SELF" >&2
    exit 2
}

# Host names become file names and ssh targets: keep them boring.
valid_host() {
    case $1 in ""|-*|.|..|"$SELF") return 1 ;; esac
    case $1 in @*|*@|*@*@*) return 1 ;; esac
    [[ $1 =~ ^[A-Za-z0-9._@-]+$ ]]
}

# check_host <name> [what]: valid_host, with a message saying what's wrong.
check_host() {
    case $1 in
        -*) die_soft "unknown option '$1'"; return 1 ;;
        "") die_soft "empty ${2:-host} name"; return 1 ;;
    esac
    valid_host "$1" && return 0
    die_soft "'$1' is not a valid ${2:-host} name (letters, digits, '.', '_', '@', '-')"
    return 1
}

# list_file <kind>: the host list file for "gpu", "audio", "share" or "host".
list_file() {
    case $1 in
        gpu)   printf '%s\n' "$GPU_HOSTS_FILE" ;;
        audio) printf '%s\n' "$AUDIO_HOSTS_FILE" ;;
        share) printf '%s\n' "$SHARE_HOSTS_FILE" ;;
        host)  printf '%s\n' "$HOSTS_FILE" ;;
    esac
}

# list_entries <kind>: the host entries of that list, comments and blanks dropped.
list_entries() {
    local f l=''
    f=$(list_file "$1")
    [ -r "$f" ] || return 0
    while IFS= read -r l || [ -n "$l" ]; do
        l=${l%%#*}                                   # strip comments
        l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"
        [ -n "$l" ] && printf '%s\n' "$l"
    done < "$f"
}

# host_listed <kind> <host>: in that list? Matches the host as given or without
# a user@ prefix (so "alice@myvm" matches a "myvm" line).
host_listed() {
    local h=$2 bare=${2##*@} l
    while IFS= read -r l; do
        [ "$l" = "$h" ] || [ "$l" = "$bare" ] && return 0
    done < <(list_entries "$1")
    return 1
}
is_gpu_host()   { host_listed gpu "$1"; }
is_audio_host() { host_listed audio "$1"; }
is_share_host() { host_listed share "$1"; }

# setting_get <key> <default>: a value from SETTINGS_FILE ("<key> <value>"
# lines, # comments), or <default>.
setting_get() {
    local l k v
    if [ -r "$SETTINGS_FILE" ]; then
        while IFS= read -r l || [ -n "$l" ]; do
            read -r k v <<< "${l%%#*}"
            if [ "${k:-}" = "$1" ] && [ -n "${v:-}" ]; then printf '%s\n' "$v"; return; fi
        done < "$SETTINGS_FILE"
    fi
    printf '%s\n' "$2"
}

# Serialize configuration writers without requiring flock. Unknown or remote
# lock owners are never removed automatically.
CONFIG_LOCK_DEPTH=0
CONFIG_LOCK_OWNER=
CONFIG_LOCK_EXIT=
CONFIG_LOCK_SIGNALS=
CONFIG_EDIT_TMP=
config_unlock() {
    [ "$CONFIG_LOCK_DEPTH" -gt 0 ] || return 0
    CONFIG_LOCK_DEPTH=$((CONFIG_LOCK_DEPTH - 1))
    [ "$CONFIG_LOCK_DEPTH" -eq 0 ] || return 0
    if [ "$(cat "$CONFIG_DIR/.lock/owner" 2>/dev/null)" = "$CONFIG_LOCK_OWNER" ]; then
        rm -f -- "$CONFIG_DIR/.lock/owner"
        rmdir -- "$CONFIG_DIR/.lock" 2>/dev/null || true
    fi
    [ -z "$CONFIG_EDIT_TMP" ] || rm -f -- "$CONFIG_EDIT_TMP"
    CONFIG_EDIT_TMP=
    trap - EXIT INT TERM HUP
    [ -z "$CONFIG_LOCK_EXIT" ] || eval "$CONFIG_LOCK_EXIT"
    [ -z "$CONFIG_LOCK_SIGNALS" ] || eval "$CONFIG_LOCK_SIGNALS"
}
config_lock_exit() {
    local previous=$CONFIG_LOCK_EXIT
    CONFIG_LOCK_DEPTH=1
    config_unlock
    # Restoring an EXIT trap while already handling EXIT does not run it.
    # Chain the previous handler explicitly, preserving its shell quoting.
    trap - EXIT
    if [ -n "$previous" ]; then
        eval "set -- ${previous#trap -- }"
        eval "$1"
    fi
}
config_lock() {
    if [ "$CONFIG_LOCK_DEPTH" -gt 0 ]; then
        CONFIG_LOCK_DEPTH=$((CONFIG_LOCK_DEPTH + 1)); return 0
    fi
    mkdir -p "$CONFIG_DIR" || { die_soft "cannot create $CONFIG_DIR"; return 1; }
    local owner machine pid lock_machine attempt=0
    machine=$(uname -n)
    while ! mkdir "$CONFIG_DIR/.lock" 2>/dev/null; do
        owner=$(cat "$CONFIG_DIR/.lock/owner" 2>/dev/null) || owner=
        read -r lock_machine pid <<< "$owner"
        if [ "${lock_machine:-}" = "$machine" ] && [[ ${pid:-} =~ ^[0-9]+$ ]] &&
           ! kill -0 "$pid" 2>/dev/null && ! ps -p "$pid" >/dev/null 2>&1; then
            # One cleaner at a time; remove only the still-dead owner.
            if mkdir "$CONFIG_DIR/.lock-recovery" 2>/dev/null; then
                if [ "$(cat "$CONFIG_DIR/.lock/owner" 2>/dev/null)" = "$owner" ] &&
                   ! kill -0 "$pid" 2>/dev/null && ! ps -p "$pid" >/dev/null 2>&1; then
                    rm -f "$CONFIG_DIR/.lock/owner"
                    rmdir "$CONFIG_DIR/.lock" 2>/dev/null || true
                fi
                rmdir "$CONFIG_DIR/.lock-recovery" 2>/dev/null || true
            fi
        fi
        attempt=$((attempt + 1))
        [ "$attempt" -lt 100 ] || { die_soft "timed out waiting for $CONFIG_DIR/.lock"; return 1; }
        sleep 0.1 2>/dev/null || sleep 1
    done
    CONFIG_LOCK_OWNER="$machine $BASHPID"
    if ! printf '%s\n' "$CONFIG_LOCK_OWNER" > "$CONFIG_DIR/.lock/owner"; then
        rmdir "$CONFIG_DIR/.lock" 2>/dev/null || true
        die_soft "cannot record configuration lock owner"; return 1
    fi
    CONFIG_LOCK_EXIT=$(trap -p EXIT)
    CONFIG_LOCK_SIGNALS=$(trap -p INT TERM HUP)
    CONFIG_LOCK_DEPTH=1
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    trap config_lock_exit EXIT
}

# config_edit FILE MODE KEY [VALUE]: replace a complete file while holding
# the lock. Resolve intentional symlinks and preserve an existing file's mode.
config_edit() {
    local rc
    config_lock || return 1
    config_edit_locked "$@"; rc=$?
    config_unlock
    return "$rc"
}
config_edit_locked() {
    local file=$1 mode=$2 key=$3 value=${4:-} target tmp line match k rest found=0 atomic=1
    target=$(resolve "$file") || { die_soft "cannot resolve $file"; return 2; }
    if [ -e "$target" ] && { [ ! -f "$target" ] || [ ! -r "$target" ] || [ ! -w "$target" ]; }; then
        die_soft "configuration is not a writable regular file: $file"; return 2
    fi
    case $mode in remove-*) [ -f "$target" ] || return 1 ;; esac
    mkdir -p "${target%/*}" || { die_soft "cannot create ${target%/*}"; return 2; }
    tmp=$(mktemp "${target%/*}/.saypipe-edit.XXXXXX" 2>/dev/null) || {
        # Some intentional symlink targets permit writes but not a sibling
        # rename. Keep those usable, under the same writer lock.
        [ -f "$target" ] && [ -w "$target" ] || {
            die_soft "cannot create a replacement beside $file"; return 2;
        }
        tmp=$(mktemp "${TMPDIR:-/tmp}/saypipe-edit.XXXXXX") || {
            die_soft "cannot stage configuration update for $file"; return 2;
        }
        atomic=0
    }
    CONFIG_EDIT_TMP=$tmp
    if [ -f "$target" ]; then
        if ! cp -p "$target" "$tmp"; then
            rm -f "$tmp"; die_soft "cannot preserve permissions of $file"; return 2
        fi
    fi
    if ! {
        if [ -f "$target" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                if [[ $mode == *-list ]]; then
                    match=${line%%#*}
                    match="${match#"${match%%[![:space:]]*}"}"
                    match="${match%"${match##*[![:space:]]}"}"
                else
                    read -r k rest <<< "$line"
                    match=${k:-}
                fi
                if [ "$match" = "$key" ]; then found=1; else printf '%s\n' "$line"; fi
            done < "$target"
        else
            printf '# saypipe configuration\n'
        fi
        case $mode in
            add-list) printf '%s\n' "$key" ;;
            set-field) printf '%s %s\n' "$key" "$value" ;;
        esac
    } > "$tmp"; then
        rm -f "$tmp"; die_soft "cannot write replacement for $file"; return 2
    fi
    if [[ $mode == remove-* ]] && [ "$found" -eq 0 ]; then rm -f "$tmp"; return 1; fi
    if [ "$atomic" -eq 0 ]; then
        if ! cat "$tmp" > "$target"; then
            rm -f "$tmp"; die_soft "cannot update $file"; return 2
        fi
        rm -f "$tmp"
    elif ! mv -f -- "$tmp" "$target"; then
        rm -f "$tmp"; die_soft "cannot replace $file"; return 2
    fi
}
setting_set() { config_edit "$SETTINGS_FILE" set-field "$1" "$2"; }

# alias_target <name>: the host an alias stands for (ALIASES_FILE holds
# "<alias> <host>" lines), or failure if <name> isn't an alias.
alias_target() {
    local l a t rest
    [ -r "$ALIASES_FILE" ] || return 1
    while IFS= read -r l || [ -n "$l" ]; do
        read -r a t rest <<< "${l%%#*}"
        if [ "${a:-}" = "$1" ] && [ -n "${t:-}" ]; then printf '%s\n' "$t"; return 0; fi
    done < "$ALIASES_FILE"
    return 1
}

# alias_names: every alias in ALIASES_FILE.
alias_names() {
    local l a rest
    [ -r "$ALIASES_FILE" ] || return 0
    while IFS= read -r l || [ -n "$l" ]; do
        read -r a rest <<< "${l%%#*}"
        [ -n "${a:-}" ] && printf '%s\n' "$a"
    done < "$ALIASES_FILE"
}

# real_host <name>: the host behind an alias, or <name> itself.
real_host() { alias_target "$1" || printf '%s\n' "$1"; }

# default_cmd <host>: the command <host> runs when none is given
# (COMMANDS_FILE holds "<host> <command...>" lines, "*" for the global default;
# a "user@host" target matches a "host" line). Fails if there is none.
# Commands may contain '#', so only whole-line comments count.
default_cmd() {
    local l k rest inherited=
    [ -r "$COMMANDS_FILE" ] || return 1
    while IFS= read -r l || [ -n "$l" ]; do
        read -r k rest <<< "$l"
        case ${k:-} in ""|"#"*) continue ;; esac
        [ -n "${rest:-}" ] || continue
        if [ "$k" = "$1" ]; then printf '%s\n' "$rest"; return 0; fi
        if [ "$k" = "${1##*@}" ] && [ -z "$inherited" ]; then inherited=$rest; fi
    done < "$COMMANDS_FILE"
    [ -n "$inherited" ] || return 1
    printf '%s\n' "$inherited"
}

# default_hosts: hosts with a default command (not the global "*").
default_hosts() {
    local l k rest
    [ -r "$COMMANDS_FILE" ] || return 0
    while IFS= read -r l || [ -n "$l" ]; do
        read -r k rest <<< "$l"
        case ${k:-} in ""|"#"*|'*') continue ;; esac
        [ -n "${rest:-}" ] && printf '%s\n' "$k"
    done < "$COMMANDS_FILE"
}

# share_opts <host>: set SHARE_SSH to the ssh options for connection sharing
# (one ControlMaster connection carrying every session to the host) if the
# host is listed in share-hosts, else to nothing (ssh's own config applies).
# With <force> as $2, set them regardless (for --share-exit).
SHARE_SSH=()
share_opts() {
    SHARE_SSH=()
    is_share_host "$1" || [ -n "${2:-}" ] || return 0
    local path
    for path in "$SHARE_RUNTIME" "${SHARE_DIR%/cm}" "$SHARE_DIR"; do
        if [ -L "$path" ] || { [ -e "$path" ] && { [ ! -d "$path" ] || [ ! -O "$path" ]; }; }; then
            die_soft "unsafe SSH control directory: $path"; return 1
        fi
        mkdir -p "$path" && chmod 700 "$path" || {
            die_soft "cannot create private SSH control directory: $path"; return 1;
        }
    done
    SHARE_SSH=(-o ControlMaster=auto -o "ControlPath=$SHARE_DIR/%C"
               -o "ControlPersist=${SAYPIPE_SHARE_PERSIST:-10m}"
               -o ServerAliveInterval=15 -o ServerAliveCountMax=3)
}

# pulse_socket: the local PulseAudio (or pipewire-pulse) socket path.
pulse_socket() {
    printf '%s\n' "${PULSE_RUNTIME_PATH:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse}/native"
}

# audio_setup <host>: for an audio-enabled host, forward the local PulseAudio
# socket to a random remote path over the same ssh connection and point the
# remote app at it. Sets AUDIO_SSH (ssh options), AUDIO_ENV (command prefix)
# and AUDIO_RSOCK (remote socket path, removed again after the session).
AUDIO_SSH=(); AUDIO_ENV=(); AUDIO_RSOCK=; AUDIO_LSOCK=
audio_setup() {
    is_audio_host "$1" || return 0
    AUDIO_LSOCK=$(pulse_socket)
    if [ ! -S "$AUDIO_LSOCK" ]; then
        echo "$SELF: audio: no PulseAudio socket at $AUDIO_LSOCK; continuing without audio" >&2
        AUDIO_LSOCK=
        return 0
    fi
    # Random name: sshd won't replace an existing socket (StreamLocalBindUnlink
    # defaults to no), and concurrent sessions must not collide.
    AUDIO_RSOCK=/tmp/saypipe-pulse-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n').sock
    AUDIO_SSH=(-o ExitOnForwardFailure=no -R "$AUDIO_RSOCK:$AUDIO_LSOCK")
    AUDIO_ENV=(env "PULSE_SERVER=unix:$AUDIO_RSOCK")
}

# audio_cleanup <host>: undo the audio forward after the session. sshd leaves
# the socket file behind, and with ssh connection sharing (ControlMaster) the
# master also keeps the forward listening until it exits, so cancel it there.
audio_cleanup() {
    [ -n "$AUDIO_RSOCK" ] || return 0
    if ssh "${SHARE_SSH[@]}" -O check "$1" >/dev/null 2>&1; then
        ssh "${SHARE_SSH[@]}" -O cancel -R "$AUDIO_RSOCK:$AUDIO_LSOCK" "$1" >/dev/null 2>&1
    fi
    ssh "${SHARE_SSH[@]}" -o BatchMode=yes -o ConnectTimeout=5 "$1" \
        rm -f -- "$AUDIO_RSOCK" >/dev/null 2>&1
}

# wp_opts <host>: set WP_OPTS to the waypipe options for that host.
WP_OPTS=()
wp_opts() {
    if [ -n "${SAYPIPE_OPTS:-}" ]; then
        read -r -a WP_OPTS <<< "$SAYPIPE_OPTS"
    elif is_gpu_host "$1"; then
        WP_OPTS=(-c zstd)
    else
        WP_OPTS=(-n -c zstd)
    fi
}

usage() {
    local d=${SAYPIPE_BIN_DIR:-~/.local/bin}
    cat <<EOF
Usage: $SELF [--] <host> [<command...>]
       <host-link> [<command...>]

Runs <command> on <host> through waypipe over ssh, detached from the terminal.
Everything after the host is the command. Without one, the host's default
command runs (see --default-set). A launch that fails right away is reported
here; failures are also logged to $ERROR_LOG.

Hosts:
  --host-add [--force] <host>...   enable hosts, after checking they have
                                   waypipe (--force skips the check)
  --host-remove <host>...          remove hosts with all their options,
                                   aliases and links
  --list [<list>]                  enabled hosts with their options, or one
                                   list: hosts gpu audio share aliases links
                                   defaults
  --probe [--apply] <host>...      test what hosts support; --apply enables it

Host options (adding one enables the host; --force works here too):
  --gpu-add <host>...              apps may share GPU buffers (no waypipe -n)
  --gpu-remove <host>...
  --audio-add <host>...            play the host's app audio on this machine
  --audio-remove <host>...
  --share-add <host>...            sessions to the host share one ssh connection
  --share-remove <host>...
  --share-exit <host>...           close a shared connection (closes its apps)
  --default-set <host> <command...>
                                   command the host runs when given none
  --default-set --global <command...>
                                   ... for hosts without a default of their own
  --default-remove <host>...|--global
  --alias-add <alias> <host>       <alias> connects to <host>; also links it
  --alias-remove <alias>...        remove aliases and their links
  --link-add <host>...             make <host> a command in $d
  --link-remove <host>...

Settings:
  --completion-hosts [all|enabled] host completion offers all ssh config hosts
                                   (default) or only enabled ones
  --foreground, --verbose         stay attached and stream application output
  --doctor                        inspect local tools, display and configuration
  --version                       print the installed version
  -h, --help                       this help

Environment: SAYPIPE_OPTS (waypipe options for every host), SAYPIPE_BIN_DIR
(links), SAYPIPE_SHARE_PERSIST (shared connection lifetime, default 10m),
SAYPIPE_WAIT (startup watch, default 2 seconds), SAYPIPE_FOREGROUND=1,
SAYPIPE_STARTUP_WINDOW (exit-1 startup classification, default 5 seconds),
SAYPIPE_LOG_BYTES (session output cap, default 65536 bytes),
SAYPIPE_PROBE_TIMEOUT (post-authentication probe timeout, default 15 seconds).
EOF
}

# ---- worker -----------------------------------------------------------------

# Internal: the detached worker. Runs waypipe; on a real failure appends the
# tail of its output to ERROR_LOG. If the launching saypipe is still watching
# (SAYPIPE_STATUS names a file it waits on), report the result there.
# Capture in bounded chunks, independently of a remote process that keeps
# stdout open after its main command exits. Logs contain private app output.
capture_log() {
    local chunk= size=0
    local LC_ALL=C
    trap 'exit 0' TERM INT HUP
    while :; do
        chunk=
        if IFS= read -r -n 4096 chunk; then
            [ "${#chunk}" -ge 4096 ] || chunk+=$'\n'
        else
            [ -n "$chunk" ] || break
        fi
        printf '%s' "$chunk" >> "$log"
        if [ "${SAYPIPE_FOREGROUND:-0}" = 1 ]; then printf '%s' "$chunk"; fi
        size=$((size + ${#chunk}))
        if [ "$size" -gt "$log_limit" ]; then
            tail -c "$log_limit" "$log" > "$session_dir/trimmed"
            cat "$session_dir/trimmed" > "$log"
            size=$log_limit
        fi
    done
}
record_failure() (
    # Separate lock scope for the state log; the worker's EXIT trap must stay
    # in its parent, where it owns the child processes and session directory.
    trap - EXIT INT TERM HUP
    CONFIG_DIR=$STATE_DIR
    CONFIG_LOCK_DEPTH=0
    config_lock || return 1
    chmod 700 "$STATE_DIR" 2>/dev/null || true
    if [ -f "$ERROR_LOG" ]; then
        tail -c 262144 "$ERROR_LOG" > "$session_dir/errors-old" || return 1
    else
        : > "$session_dir/errors-old"
    fi
    {
        cat "$session_dir/errors-old"
        printf '[%s] host %s: exit %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$host" "$rc"
        tail -c "$log_limit" "$log" | sed 's/^/  /'
    } > "$session_dir/errors-new"
    cat "$session_dir/errors-new" > "$ERROR_LOG" || return 1
    chmod 600 "$ERROR_LOG" 2>/dev/null || true
    config_unlock
)

if [ "${1:-}" = "--run" ]; then
    [ $# -ge 3 ] || { echo "$SELF: --run is internal" >&2; exit 2; }
    host=$2; shift 2
    status_dir=${SAYPIPE_STATUS:-}; unset SAYPIPE_STATUS
    umask 077
    session_dir=$(mktemp -d "${TMPDIR:-/tmp}/saypipe-session.XXXXXX") || exit 1
    log=$session_dir/output
    : > "$log"
    log_limit=${SAYPIPE_LOG_BYTES:-65536}
    [[ $log_limit =~ ^[0-9]+$ ]] && [ "$log_limit" -ge 4096 ] && [ "$log_limit" -le 1048576 ] || log_limit=65536
    startup_window=${SAYPIPE_STARTUP_WINDOW:-5}
    [[ $startup_window =~ ^[0-9]+$ ]] || startup_window=5
    waypipe_pid='' capture_pid='' drain_pid='' cleaned=0
    worker_cleanup() {
        [ "$cleaned" = 0 ] || return 0
        cleaned=1
        [ -z "$waypipe_pid" ] || kill -TERM "$waypipe_pid" 2>/dev/null || true
        [ -z "$waypipe_pid" ] || wait "$waypipe_pid" 2>/dev/null || true
        [ -z "$capture_pid" ] || kill -TERM "$capture_pid" 2>/dev/null || true
        [ -z "$drain_pid" ] || kill -TERM "$drain_pid" 2>/dev/null || true
        audio_cleanup "$host"
        rm -rf -- "$session_dir"
    }
    trap worker_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    [ -z "$status_dir" ] || { printf started > "$status_dir/started"; } 2>/dev/null || true
    wp_opts "$host"
    share_opts "$host" || exit 1
    audio_setup "$host" 2>>"$log"
    # Only portable ASCII shell text reaches the remote login shell. Encoding
    # avoids the different single-quote/backslash rules of fish and csh, and
    # carries multiline commands without literal newlines in SSH's command.
    remote_command="${AUDIO_ENV[*]}${AUDIO_ENV[*]:+ }$*"
    remote_command=$(printf '%s' "$remote_command" | od -An -v -to1 | awk '{for (i=1;i<=NF;i++) printf "\\0%s", $i}')
    remote_session='cmd=$(printf "%b" "$1"); if command -v dbus-run-session >/dev/null 2>&1; then exec dbus-run-session -- "${SHELL:-/bin/sh}" -c "$cmd"; else exec "${SHELL:-/bin/sh}" -c "$cmd"; fi'
    mkfifo "$session_dir/stream" || exit 1
    capture_log < "$session_dir/stream" & capture_pid=$!
    started=$SECONDS
    waypipe "${WP_OPTS[@]}" ssh "${SHARE_SSH[@]}" "${AUDIO_SSH[@]}" "$host" \
        "sh -c '$remote_session' saypipe '$remote_command'" </dev/null >"$session_dir/stream" 2>&1 & waypipe_pid=$!
    wait "$waypipe_pid"; rc=$?
    waypipe_pid=''
    # Give the reader time to drain, but never wait forever for a daemon's
    # inherited descriptor. The watchdog never holds the capture pipe open.
    ( sleep 1; kill -TERM "$capture_pid" 2>/dev/null || true ) </dev/null >/dev/null 2>&1 & drain_pid=$!
    wait "$capture_pid" 2>/dev/null || true
    kill -TERM "$drain_pid" 2>/dev/null || true
    wait "$drain_pid" 2>/dev/null || true
    capture_pid='' drain_pid=''
    failed=0
    if [ "$rc" -ne 0 ]; then
        case $rc in
            129|130|143) ;;
            1) if [ $((SECONDS - started)) -le "$startup_window" ] || grep -Eqi 'fatal|error|failed' "$log"; then failed=1; fi ;;
            *) failed=1 ;;
        esac
    fi
    grep -q 'Failed to run program' "$log" 2>/dev/null && failed=1
    [ "$failed" = 0 ] || record_failure
    if [ -n "$status_dir" ] && [ -d "$status_dir" ]; then
        { printf '%s\n' "$rc"; tail -c "$log_limit" "$log"; } > "$status_dir/finished.new" 2>/dev/null &&
            mv -f -- "$status_dir/finished.new" "$status_dir/finished" 2>/dev/null || true
    fi
    exit "$rc"
fi

# ---- management -------------------------------------------------------------

SCRIPT_PATH=$(resolve "$0")
# Host links go where commands live, not next to the real script (which may be
# a git checkout symlinked into PATH).
LINK_DIR=${SAYPIPE_BIN_DIR:-$HOME/.local/bin}

# link_target: what a new host link points at. "saypipe" (relative) when
# LINK_DIR has a saypipe that is this script, else this script's full path.
link_target() {
    if [ -e "$LINK_DIR/$SELF" ] && [ "$(resolve "$LINK_DIR/$SELF")" = "$SCRIPT_PATH" ]; then
        printf '%s\n' "$SELF"
    else
        printf '%s\n' "$SCRIPT_PATH"
    fi
}

# is_our_link <path>: a symlink that resolves to this script.
is_our_link() { [ -L "$1" ] && [ "$(resolve "$1")" = "$SCRIPT_PATH" ]; }

# link_names: names of host and alias links that point to this saypipe.
link_names() {
    local f
    for f in "$LINK_DIR"/*; do
        [ "${f##*/}" != "$SELF" ] && is_our_link "$f" && printf '%s\n' "${f##*/}"
    done
    return 0
}

# shadow_check <name> <what>: fail (with a message) if a link called <name>
# can't be created: something else exists there, or it would shadow a command.
shadow_check() {
    local t=$LINK_DIR/$1
    is_our_link "$t" && return 0
    if [ -e "$t" ] || [ -L "$t" ]; then
        die_soft "$t exists and isn't a $SELF link; pick another $2"; return 1
    fi
    if type -t -- "$1" >/dev/null 2>&1; then
        die_soft "'$1' is already a command ($(type -t -- "$1"): $(command -v -- "$1")); pick another $2"
        return 1
    fi
}

# make_link <name>: create a <name> link to this saypipe in LINK_DIR.
make_link() {
    local t=$LINK_DIR/$1
    is_our_link "$t" && return 0
    mkdir -p -- "$LINK_DIR" || { die_soft "cannot create $LINK_DIR"; return 1; }
    ln -s -- "$(link_target)" "$t" && LINKS_MADE=1 && echo "$1: linked ($t)"
}

# ---- enabled hosts ----------------------------------------------------------

# enabled_hosts: every enabled host: the host list plus hosts that have
# options (GPU, audio, sharing, a default command), alias targets and links.
enabled_hosts() {
    local n
    {
        list_entries host; list_entries gpu; list_entries audio; list_entries share
        default_hosts
        while IFS= read -r n; do alias_target "$n"; done < <(alias_names)
        while IFS= read -r n; do real_host "$n"; done < <(link_names)
    } | sort -u
}

# is_enabled <host>: enabled? ("user@host" matches "host")
is_enabled() {
    local l
    while IFS= read -r l; do
        [ "$l" = "$1" ] || [ "$l" = "${1##*@}" ] && return 0
    done < <(enabled_hosts)
    return 1
}

# Framed version facts tolerate login banners without accepting an error as
# a successful version. Both host enabling and probing use this protocol.
WAYPIPE_REMOTE='
if command -v waypipe >/dev/null 2>&1; then
    v=$(waypipe --version 2>&1); rc=$?
    printf "@@saypipe-waypipe@@%s|%s\n" "$rc" "$(printf "%s\n" "$v" | head -n 1)"
    case $v in *"dmabuf: true"*) echo dmabuf=yes ;; *"dmabuf: false"*) echo dmabuf=no ;; esac
else
    echo "@@saypipe-waypipe@@127|waypipe is not installed"
fi'
REMOTE_VERSION=
parse_waypipe_version() {
    local line status version
    REMOTE_VERSION=
    while IFS= read -r line; do
        case $line in
            '@@saypipe-waypipe@@'*)
                line=${line#@@saypipe-waypipe@@}
                status=${line%%|*}; version=${line#*|}
                if [ "$status" = 0 ] && [ -n "$version" ]; then
                    REMOTE_VERSION=$version; return 0
                fi
                return 1 ;;
        esac
    done <<< "$1"
    return 1
}
waypipe_check() {
    local out rc
    share_opts "$1" || return 1
    out=$(ssh "${SHARE_SSH[@]}" -o ConnectTimeout=10 "$1" sh -s <<< "$WAYPIPE_REMOTE" 2>&1); rc=$?
    if [ "$rc" -ne 0 ]; then printf 'remote check failed (ssh exit %s)\n' "$rc"; return 1; fi
    if ! parse_waypipe_version "$out"; then
        echo "waypipe version check failed or returned no valid answer"; return 1
    fi
    printf '%s\n' "$REMOTE_VERSION" | tr -d '[:cntrl:]'
    printf '\n'
}

# ensure_enabled <host>: make sure <host> is enabled, checking first that it
# has waypipe (unless --force). Fails, with a message, if it can't be.
ensure_enabled() {
    local h=$1 v
    is_enabled "$h" && return 0
    if [ "$FORCE" = 1 ]; then
        list_append host "$h" || return 1
        echo "$h: enabled (not checked: --force)"
        return 0
    fi
    if v=$(waypipe_check "$h"); then
        list_append host "$h" || return 1
        echo "$h: enabled ($v)"
    else
        die_soft "$h: not enabled: $v (add --force to enable it without this check)"
        return 1
    fi
}

# host_add <host>...: enable hosts.
host_add() {
    local h
    for h; do
        check_host "$h" || continue
        h=$(real_host "$h")
        if is_enabled "$h"; then
            host_listed host "$h" || list_append host "$h"     # record it
            echo "$h: already enabled"
        else
            ensure_enabled "$h"
        fi
    done
}

# host_remove <host>...: remove hosts with all their options, aliases and links.
host_remove() {
    local h t kind a found names=()
    for h; do
        check_host "$h" || continue
        if t=$(alias_target "$h"); then
            die_soft "'$h' is an alias for $t; use '$SELF --alias-remove $h' or '$SELF --host-remove $t'"
            continue
        fi
        is_enabled "$h" || { die_soft "$h: not an enabled host"; continue; }
        if [[ $h == *@* ]] && [ "$(enabled_hosts | while IFS= read -r a; do [ "$a" = "$h" ] && echo yes; done)" != yes ]; then
            die_soft "$h: inherits configuration from ${h##*@}; remove ${h##*@} explicitly"
            continue
        fi
        found=0
        for kind in host gpu audio share; do
            if list_entries "$kind" | awk -v h="$h" '$0 == h { found=1 } END { exit !found }'; then
                list_drop "$kind" "$h" || found=1
            fi
        done
        [ "$found" -eq 0 ] || continue
        if default_cmd "$h" >/dev/null; then
            default_drop "$h"
            [ "$?" -lt 2 ] || continue
        fi
        mapfile -t names < <(alias_names)
        for a in "${names[@]}"; do
            [ "$(alias_target "$a")" = "$h" ] || continue
            alias_drop "$a" || { found=1; break; }
            if is_our_link "$LINK_DIR/$a"; then
                rm -f -- "$LINK_DIR/$a" || { die_soft "cannot remove alias link $a"; found=1; break; }
            fi
            echo "$h: alias $a removed"
        done
        [ "$found" -eq 0 ] || continue
        if is_our_link "$LINK_DIR/$h"; then
            rm -f -- "$LINK_DIR/$h" || { die_soft "cannot remove $LINK_DIR/$h"; continue; }
            echo "$h: link removed"
        fi
        if [[ $h == *@* ]] && is_enabled "$h"; then
            echo "$h: exact entries removed (still inherits from ${h##*@})"
        else
            echo "$h: removed (with its options)"
        fi
    done
}

# ---- option lists (gpu, audio, share, host) ---------------------------------

# list_label <kind>: how messages name the feature.
list_label() {
    case $1 in
        gpu) echo GPU ;; audio) echo audio ;; share) echo "connection sharing" ;;
        host) echo "enabled" ;;
    esac
}

# Config mutation is atomic and serialized, including duplicate suppression.
list_append() { config_edit "$(list_file "$1")" add-list "$2"; }
list_drop() { config_edit "$(list_file "$1")" remove-list "$2"; }

# option_add <kind> <host>...: enable an option (enabling the host first).
option_add() {
    local kind=$1 label h; shift
    label=$(list_label "$kind")
    for h; do
        check_host "$h" || continue
        h=$(real_host "$h")                         # options follow the real host
        if host_listed "$kind" "$h"; then echo "$h: $label already enabled"; continue; fi
        ensure_enabled "$h" || continue
        list_append "$kind" "$h" || continue
        case $kind in
            gpu)   echo "$h: GPU enabled (runs without -n)" ;;
            audio) echo "$h: audio enabled (sound plays on this machine)" ;;
            share) echo "$h: connection sharing enabled (applies to new launches)" ;;
        esac
    done
    return "$mgmt_rc"
}

# option_remove <kind> <host>...
option_remove() {
    local kind=$1 label h e; shift
    label=$(list_label "$kind")
    for h; do
        check_host "$h" || continue
        h=$(real_host "$h")
        if [[ $h == *@* ]] && host_listed "$kind" "$h" &&
           ! list_entries "$kind" | awk -v h="$h" '$0 == h { found=1 } END { exit !found }'; then
            die_soft "$h: inherits $label from ${h##*@}; use '$SELF --$kind-remove ${h##*@}'"
            continue
        fi
        if list_drop "$kind" "$h"; then
            if host_listed "$kind" "$h"; then
                echo "$h: $label entry removed (still inherited from ${h##*@})"
                continue
            fi
            case $kind in
                gpu)   echo "$h: GPU disabled (runs with -n)" ;;
                audio) echo "$h: audio disabled" ;;
                share) echo "$h: connection sharing disabled" \
                            "(an open master stays until '$SELF --share-exit $h' or it times out)" ;;
            esac
            continue
        fi
        # "alice@myvm" lines match "myvm" only one way round: point to them.
        e=$(list_entries "$kind" | while IFS= read -r e; do
                [ "${e##*@}" = "$h" ] && { printf '%s\n' "$e"; break; }; done)
        if [ -n "$e" ]; then die_soft "$h: $label is enabled as '$e'; remove that entry instead"
        else die_soft "$h: $label not enabled"; fi
    done
}

# ---- links and aliases -------------------------------------------------------

# link_add <host>...: make hosts commands in LINK_DIR.
link_add() {
    local h
    for h; do
        check_host "$h" || continue
        if is_our_link "$LINK_DIR/$h"; then echo "$h: link already exists"; continue; fi
        shadow_check "$h" "host name, or use --alias-add" || continue
        if ! alias_target "$h" >/dev/null; then ensure_enabled "$h" || continue; fi
        make_link "$h"
    done
}

# link_remove <host>...: remove host links (alias links go with --alias-remove).
link_remove() {
    local h t
    for h; do
        check_host "$h" || continue
        if t=$(alias_target "$h"); then
            die_soft "'$h' is an alias for $t; use '$SELF --alias-remove $h'"; continue
        fi
        t=$LINK_DIR/$h
        if is_our_link "$t"; then
            if rm -f -- "$t"; then echo "$h: link removed"; else die_soft "cannot remove $t"; fi
        elif [ -e "$t" ] || [ -L "$t" ]; then die_soft "$t isn't a $SELF link; not touching it"
        else die_soft "$h: no link"
        fi
    done
}

# alias_drop <alias>: remove an alias's line from ALIASES_FILE (rewritten in
# place, keeping permissions). Fails if there was no such alias.
alias_drop() { config_edit "$ALIASES_FILE" remove-field "$1"; }

# alias_add <alias> <host>: record that <alias> means <host> and link it, for
# a host whose name clashes with a command or that you'd rather call
# something else.
alias_add() {
    local a=$1 h=$2 old
    check_host "$a" alias || return
    check_host "$h" || return
    [ "$a" != "$h" ] || { die_soft "the alias is the host name; use '$SELF --link-add $h'"; return; }
    if old=$(alias_target "$h"); then
        die_soft "'$h' is itself an alias (for $old); give the real host"; return
    fi
    if ! alias_target "$a" >/dev/null && is_enabled "$a"; then
        die_soft "'$a' is an enabled host; pick another alias"; return
    fi
    shadow_check "$a" alias || return
    ensure_enabled "$h" || return
    if old=$(alias_target "$a") && [ "$old" = "$h" ]; then
        echo "$a: already an alias for $h"
    else
        config_edit "$ALIASES_FILE" set-field "$a" "$h" || return
        echo "$a: alias for $h${old:+ (was $old)}"
    fi
    make_link "$a"
}

# alias_remove <alias>...: remove aliases and their links.
alias_remove() {
    local a
    for a; do
        check_host "$a" alias || continue
        if alias_drop "$a"; then
            if is_our_link "$LINK_DIR/$a"; then
                rm -f -- "$LINK_DIR/$a" || { die_soft "cannot remove alias link $a"; continue; }
            fi
            echo "$a: alias removed"
        else
            die_soft "$a: not an alias"
        fi
    done
}

# ---- default commands ----------------------------------------------------------

# default_drop <key>: remove a default command line (a host, or "*" for the
# global one) from COMMANDS_FILE (rewritten in place). Fails if there was none.
default_drop() { config_edit "$COMMANDS_FILE" remove-field "$1"; }

# default_set <key> <command...>: store the command a host (or "*", the global
# default) runs when given none, replacing an old one.
default_set() {
    local h=$1 c old label; shift
    c="$*"
    case $c in *$'\n'*) die_soft "the command must be on one line"; return ;; esac
    [ -n "${c//[[:space:]]/}" ] || { die_soft "no command given"; return; }
    if [ "$h" = '*' ]; then
        label="global"
    else
        check_host "$h" || return
        h=$(real_host "$h") label=$(real_host "$h")   # defaults follow the real host
        ensure_enabled "$h" || return
    fi
    old=$(default_cmd "$h") || old=
    config_edit "$COMMANDS_FILE" set-field "$h" "$c" || return
    echo "$label: default command: $c${old:+ (was: $old)}"
}

# default_remove <host>...
default_remove() {
    local h
    for h; do
        if [ "$h" = '*' ]; then
            if default_drop '*'; then echo "global default command removed"
            else die_soft "no global default command"; fi
            continue
        fi
        check_host "$h" || continue
        h=$(real_host "$h")
        if [[ $h == *@* ]] && default_cmd "$h" >/dev/null &&
           ! awk -v h="$h" '$1 == h { found=1 } END { exit !found }' "$COMMANDS_FILE"; then
            die_soft "$h: inherits a default from ${h##*@}; use '$SELF --default-remove ${h##*@}'"
            continue
        fi
        if default_drop "$h"; then echo "$h: default command removed"
        else die_soft "$h: no default command"; fi
    done
}

# ---- listing -------------------------------------------------------------------

# list_all: enabled hosts and aliases, sorted, with their options.
list_all() {
    local n t c shown joined notes
    {
        enabled_hosts
        alias_names
    } | sort -u | while IFS= read -r n; do
        notes=() t=$n shown=$n joined=
        if t=$(alias_target "$n"); then shown="$n -> $t"; else t=$n; fi
        is_gpu_host "$t" && notes+=(GPU)
        is_audio_host "$t" && notes+=(audio)
        if is_share_host "$t"; then
            share_opts "$t"
            if ssh "${SHARE_SSH[@]}" -O check "$t" >/dev/null 2>&1
            then notes+=("shared (connected)"); else notes+=(shared); fi
        fi
        if c=$(default_cmd "$t"); then notes+=("runs: $c")
        elif c=$(default_cmd '*'); then notes+=("runs: $c (global default)")
        fi
        if [ ${#notes[@]} -eq 0 ]; then
            printf '%s\n' "$shown"
        else
            for c in "${notes[@]}"; do joined+="${joined:+, }$c"; done
            printf '%-20s %s\n' "$shown" "$joined"
        fi
    done
}

# list_cmd [<list>]: --list.
list_cmd() {
    local a n c
    case ${1:-} in
        "")              list_all ;;
        hosts)           enabled_hosts ;;
        gpu|audio|share) list_entries "$1" ;;
        aliases)
            while IFS= read -r a; do
                printf '%-20s -> %s\n' "$a" "$(alias_target "$a")"
            done < <(alias_names) ;;
        links)           link_names ;;
        defaults)
            if c=$(default_cmd '*'); then printf '%-20s %s\n' "* (global)" "$c"; fi
            while IFS= read -r n; do
                printf '%-20s %s\n' "$n" "$(default_cmd "$n")"
            done < <(default_hosts) ;;
        *) usage_error "unknown list '$1' (hosts, gpu, audio, share, aliases, links or defaults)" ;;
    esac
}

# ---- shell completion -------------------------------------------------------

# ssh_config_hosts [file] [depth]: concrete Host names from the ssh config,
# following Include (relative paths are under ~/.ssh). Patterns (*, ?, !)
# are skipped.
ssh_config_hosts() {
    local f=${1:-$HOME/.ssh/config} depth=${2:-0} l key rest tok g toks
    [ "$depth" -lt 8 ] && [ -r "$f" ] || return 0
    while IFS= read -r l || [ -n "$l" ]; do
        read -r key rest <<< "${l%%#*}"
        if [[ ${key:-} == *=* ]]; then rest="${key#*=} ${rest:-}"; key=${key%%=*}; fi
        read -ra toks <<< "${rest:-}"               # read -a doesn't glob
        case ${key,,} in
            host)
                for tok in ${toks[@]+"${toks[@]}"}; do
                    case $tok in *[\*\?\!]*) ;; *) printf '%s\n' "$tok" ;; esac
                done ;;
            include)
                for tok in ${toks[@]+"${toks[@]}"}; do
                    case $tok in "~/"*) tok=$HOME/${tok#\~/} ;; /*) ;; *) tok=$HOME/.ssh/$tok ;; esac
                    for g in $tok; do ssh_config_hosts "$g" $((depth + 1)); done   # glob on purpose
                done ;;
        esac
    done < "$f"
}

# complete_list <kind>: candidates for shell completion (completions/*).
complete_list() {
    case $1 in
        hosts)                    # enabled hosts (and aliases) first, then the rest
            complete_list enabled
            complete_list other ;;
        enabled)                  # enabled hosts, aliases and host links
            { enabled_hosts; alias_names; link_names; } | sort -u ;;
        enabled-hosts) enabled_hosts ;;
        other)                    # ssh config hosts that aren't enabled
            [ "$(setting_get completion-hosts all)" = all ] || return 0
            awk 'NR == FNR { seen[$0] = 1; next } !seen[$0]' \
                <(complete_list enabled) \
                <({ ssh_config_hosts; ssh_config_hosts /etc/ssh/ssh_config; } | sort -u) ;;
        gpu|audio|share) list_entries "$1" ;;
        aliases)  alias_names ;;
        defaults) default_hosts ;;
        links)    while IFS= read -r n; do alias_target "$n" >/dev/null || printf '%s\n' "$n"; done < <(link_names) ;;
        lists)    printf '%s\n' hosts gpu audio share aliases links defaults ;;
        options)
            printf '%s\n' --host-add --host-remove --list --probe --gpu-add --gpu-remove \
                --audio-add --audio-remove --share-add --share-remove --share-exit \
                --default-set --default-remove --alias-add --alias-remove --link-add \
                --link-remove --completion-hosts --foreground --verbose --doctor --version --help ;;
    esac
    return 0
}

# ---- shared connections --------------------------------------------------------

# share_exit <host>...: close saypipe's shared connection to each host.
share_exit() {
    local h
    for h; do
        check_host "$h" || continue
        h=$(real_host "$h")
        share_opts "$h" force || continue
        if ssh "${SHARE_SSH[@]}" -O check "$h" >/dev/null 2>&1; then
            ssh "${SHARE_SSH[@]}" -O exit "$h" >/dev/null 2>&1 &&
                echo "$h: shared connection closed (its apps close with it)"
        else
            die_soft "$h: no shared connection open"
        fi
    done
}

# ---- probe ------------------------------------------------------------------

# Facts gathered on the remote host (POSIX sh, run with `sh -s` so the login
# shell doesn't matter). One "key=value" per line.
PROBE_REMOTE="$WAYPIPE_REMOTE"'
printf "shell=%s\n" "${SHELL:-/bin/sh}"
for tool in sh dbus-run-session xdg-desktop-portal; do
    if command -v "$tool" >/dev/null 2>&1; then printf "tool=%s\n" "$tool"; fi
done
for d in /usr/share /usr/local/share; do
    for f in "$d"/xdg-desktop-portal/portals/*.portal; do
        [ -f "$f" ] && printf "portal=%s\n" "${f##*/}"
    done
done
for n in /dev/dri/renderD*; do
    [ -c "$n" ] || continue
    if [ -r "$n" ] && [ -w "$n" ]; then echo "render=$n"; else echo "render_noaccess=$n"; fi
done
if command -v vulkaninfo >/dev/null 2>&1; then
    echo vulkaninfo=yes
    vulkaninfo --summary 2>/dev/null | awk -F"= *" "/deviceType/ {t=\$2} /deviceName/ {print \"vkdev=\" t \"|\" \$2}"
fi
'

# probe_row <name> <result> [<detail>]
probe_row() {
    local result detail
    result=$(printf '%s' "$2" | tr -d '[:cntrl:]')
    detail=$(printf '%s' "${3:-}" | tr -d '[:cntrl:]')
    if [ -n "$detail" ]; then printf '  %-8s %-7s %s\n' "$1" "$result" "$detail"
    else printf '  %-8s %s\n' "$1" "$result"; fi
}

# Bound post-authentication SSH sessions using only shell primitives.
bounded_probe() {
    local child timer sleeper rc marker
    marker=$(mktemp "$dir/timeout.XXXXXX") || return 1
    "$@" <&3 & child=$!
    bounded_cancel() {
        local status=$1
        trap - INT TERM HUP
        kill -TERM "$child" "${timer:-}" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
        [ -z "${timer:-}" ] || wait "$timer" 2>/dev/null || true
        rm -f "$marker"
        exit "$status"
    }
    trap 'bounded_cancel 130' INT
    trap 'bounded_cancel 143' TERM
    trap 'bounded_cancel 129' HUP
    (
        trap 'kill "$sleeper" 2>/dev/null || true; exit 0' TERM INT
        sleep "${SAYPIPE_PROBE_TIMEOUT:-15}" & sleeper=$!
        wait "$sleeper" || exit 0
        printf timeout > "$marker"
        kill -TERM "$child" 2>/dev/null || true
        sleep 1
        kill -KILL "$child" 2>/dev/null || true
    ) </dev/null >/dev/null 2>&1 & timer=$!
    wait "$child"; rc=$?
    kill "$timer" 2>/dev/null || true
    wait "$timer" 2>/dev/null || true
    trap - INT TERM HUP
    if [ -s "$marker" ]; then rm -f "$marker"; echo "saypipe: remote probe timed out" >&2; return 124; fi
    rm -f "$marker"
    return "$rc"
} 3<&0

# probe_host <host> <apply>: test ssh, connection sharing, GPU and audio support
# on <host> over one temporary shared connection (one TCP connection in total,
# so ssh rate limits aren't tripped), print the results and what to enable.
probe_host() (
    local h=$1 apply=$2 dir m key val facts res
    local wp='' dmabuf='' render='' noaccess='' vulkaninfo='' hwdev='' cpudev=''
    local share=no share_why gpu=no gpu_why audio=no audio_why lsock rsock out
    local feat enabled=() suggest=() wrong=() shown=() f add_host=0
    local remote_shell='' dbus=no portal=no backends='' rc=0
    mgmt_rc=0

    dir=$(mktemp -d "${TMPDIR:-/tmp}/saypipe-probe.XXXXXX") || { die_soft "cannot create a temp dir"; return; }
    m=(-o "ControlPath=$dir/%C" -o ConnectTimeout=10)
    probe_cleanup() {
        ssh "${m[@]}" -O exit "$h" </dev/null >/dev/null 2>&1 || true
        rm -rf -- "$dir"
    }
    trap probe_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    echo "$h"
    if ! ssh "${m[@]}" -o ControlMaster=yes -o ControlPersist=30 -fN "$h"; then
        probe_row ssh FAILED "cannot connect (see the ssh error above)"
        rm -rf -- "$dir"; mgmt_rc=1; return
    fi
    probe_row ssh ok "connected"

    # Everything else runs as extra sessions over that connection; if they
    # work, connection sharing works.
    if facts=$(bounded_probe ssh "${m[@]}" -o ControlMaster=no "$h" sh -s <<< "$PROBE_REMOTE"); then
        share=yes; share_why="extra sessions reuse one connection"
    else
        rc=$?
        case $rc in 129|130|143) return "$rc" ;; esac
        share_why="sessions over a shared connection failed"
        facts=$(bounded_probe ssh "${m[@]}" -o ControlMaster=no -o ControlPath=none "$h" sh -s <<< "$PROBE_REMOTE") || facts=
    fi
    while IFS='=' read -r key val; do
        case $key in
            shell) remote_shell=$val ;;
            tool) case $val in dbus-run-session) dbus=yes ;; xdg-desktop-portal) portal=yes ;; esac ;;
            portal) backends="${backends:+$backends, }$val" ;;
            dmabuf)          dmabuf=$val ;;
            render)          render=${render:-$val} ;;
            render_noaccess) noaccess=${noaccess:-$val} ;;
            vulkaninfo)      vulkaninfo=yes ;;
            vkdev)           case $val in *CPU*) cpudev=${cpudev:-${val#*|}} ;;
                                          *)     hwdev=${hwdev:-${val#*|}} ;; esac ;;
        esac
    done <<< "$facts"

    if parse_waypipe_version "$facts"; then wp=$REMOTE_VERSION; else mgmt_rc=1; fi
    probe_row shell "${remote_shell:-unknown}"
    probe_row dbus "$dbus" "${dbus/yes/private session per launch}"
    probe_row portal "$portal" "${backends:-no backend files found}"
    if [ -n "$wp" ]; then probe_row waypipe ok "$wp${dmabuf:+ (dmabuf: $dmabuf)}"
    else probe_row waypipe MISSING "install waypipe on $h"; fi

    # GPU: waypipe needs dmabuf support, an accessible render node and a
    # hardware Vulkan device (software Vulkan can't share GPU buffers).
    if [ "$dmabuf" = no ]; then gpu_why="waypipe on $h is built without dmabuf"
    elif [ -z "$render" ] && [ -n "$noaccess" ]; then gpu_why="no access to $noaccess (add the user to the render/video group)"
    elif [ -z "$render" ]; then gpu_why="no GPU render node (/dev/dri/renderD*)"
    elif [ -n "$hwdev" ]; then gpu=yes; gpu_why="$hwdev on $render"
    elif [ -n "$vulkaninfo" ]; then gpu_why="only software Vulkan${cpudev:+ ($cpudev)} on $render"
    else gpu=likely; gpu_why="render node $render; install vulkaninfo on $h to confirm Vulkan"
    fi

    # Audio: forward the local PulseAudio socket and talk to it from the host.
    lsock=$(pulse_socket)
    if [ ! -S "$lsock" ]; then
        audio_why="no local PulseAudio socket at $lsock"
    else
        rsock=/tmp/saypipe-probe-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n').sock
        if out=$(bounded_probe ssh "${m[@]}" -o ControlMaster=no -o ExitOnForwardFailure=yes \
                     -R "$rsock:$lsock" "$h" sh -s 2>/dev/null <<EOF
if command -v pactl >/dev/null 2>&1; then
    PULSE_SERVER=unix:$rsock pactl info 2>/dev/null | sed -n 's/^Server Name: //p'
elif [ -S $rsock ]; then
    r=socket-only
    for f in /usr/lib*/libpulse.so* /usr/lib/*/libpulse.so* /usr/local/lib/libpulse.so*; do
        [ -e "\$f" ] && { r=socket+libpulse; break; }
    done
    echo "\$r"
fi
rm -f $rsock
EOF
        ); then
            case $out in
                "")             audio_why="forwarded, but nothing on $h could talk to it" ;;
                socket+libpulse) audio=yes; audio_why="socket forwarding works; libpulse present" ;;
                socket-only)    audio=likely; audio_why="socket forwarding works; libpulse/pactl not found on $h" ;;
                *)              audio=yes; audio_why="reached local sound server: $out" ;;
            esac
        else
            rc=$?
            if [ "$rc" -eq 124 ]; then audio_why="remote audio probe timed out"; mgmt_rc=1
            else audio_why="sshd on $h refused the socket forward (AllowStreamLocalForwarding?)"; fi
        fi
    fi
    probe_row shared "$share" "$share_why"
    probe_row gpu "$gpu" "$gpu_why"
    probe_row audio "$audio" "$audio_why"

    for feat in share gpu audio; do
        case $feat in share) res=$share ;; gpu) res=$gpu ;; audio) res=$audio ;; esac
        if host_listed "$feat" "$h"; then
            enabled+=("$feat")
            [ "$res" = no ] && wrong+=("$feat")
        elif [ "$res" = yes ]; then
            suggest+=("$feat")
        fi
    done
    for f in ${enabled[@]+"${enabled[@]}"}; do
        case $f in share) shown+=(shared) ;; *) shown+=("$f") ;; esac
    done
    if is_enabled "$h"; then probe_row host enabled
    elif [ -n "$wp" ] && [ "$apply" = 1 ]; then
        list_append host "$h" && probe_row host enabled "(added)"
    elif [ -n "$wp" ]; then
        probe_row host "-" "not enabled"; add_host=1
    else
        probe_row host "-" "not enabled (needs waypipe)"; suggest=()
    fi
    if [ ${#shown[@]} -gt 0 ]; then probe_row options "$(IFS=,; echo "${shown[*]}" | sed 's/,/, /g')"
    else probe_row options none; fi
    if [ ${#suggest[@]} -gt 0 ]; then
        if [ "$apply" = 1 ]; then
            for feat in "${suggest[@]}"; do
                option_add "$feat" "$h" | sed 's/^/  /'
                [ "${PIPESTATUS[0]}" -eq 0 ] || mgmt_rc=1
            done
        else
            for feat in "${suggest[@]}"; do echo "  -> $SELF --$feat-add $h"; done
        fi
    elif [ $add_host = 1 ]; then
        echo "  -> $SELF --host-add $h"       # (any --*-add above enables it too)
    fi
    for feat in ${wrong[@]+"${wrong[@]}"}; do
        echo "  !  $feat is enabled but not supported here: $SELF --$feat-remove $h"
    done
    return "$mgmt_rc"
)

# probe <apply> <host>...
probe() {
    local apply=$1 h t; shift
    for h; do
        check_host "$h" || continue
        if t=$(alias_target "$h"); then echo "($h is an alias for $t)"; h=$t; fi
        probe_host "$h" "$apply" || mgmt_rc=1
    done
}

# Local, read-only diagnostics. These checks never activate D-Bus services or
# attempt a remote login; --probe owns the authenticated remote checks.
doctor() {
    local tool version socket file bad=0
    for tool in bash ssh waypipe sh; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            probe_row "$tool" missing; bad=1; continue
        fi
        case $tool in
            bash) version=$BASH_VERSION ;;
            ssh) version=$(ssh -V 2>&1 | head -n 1) ;;
            waypipe) version=$(waypipe --version 2>&1 | head -n 1) ;;
            sh) version=available ;;
        esac
        probe_row "$tool" ok "$version"
    done
    socket=${WAYLAND_DISPLAY:-}
    case $socket in
        /*) ;;
        '') probe_row display missing 'WAYLAND_DISPLAY is unset'; bad=1 ;;
        *) socket=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$socket ;;
    esac
    if [ -n "$socket" ]; then
        if [ -S "$socket" ]; then probe_row display ok 'Wayland socket exists'
        else probe_row display missing 'Wayland socket is unavailable'; bad=1; fi
    fi
    if [ -S "${SSH_AUTH_SOCK:-/nonexistent}" ]; then probe_row agent available
    else probe_row agent unknown 'no agent socket; --probe verifies remote authentication'; fi
    if [ -d "$CONFIG_DIR" ]; then
        for file in hosts gpu-hosts audio-hosts share-hosts aliases commands settings; do
            if [ -e "$CONFIG_DIR/$file" ] || [ -L "$CONFIG_DIR/$file" ]; then
                if [ -f "$CONFIG_DIR/$file" ] && [ -r "$CONFIG_DIR/$file" ]; then probe_row config ok "$file"
                else probe_row config invalid "$file"; bad=1; fi
            fi
        done
    else probe_row config fresh 'no saved host settings'; fi
    if [ -d "$CONFIG_DIR/.lock" ]; then probe_row lock present 'configuration update is active or interrupted'; fi
    probe_row remote unknown 'use --probe HOST to check remote D-Bus and portal availability'
    return "$bad"
}

# ---- command line ---------------------------------------------------------------

# take_flag <flag>: remove every <flag> from ARGS; succeeds if there was one.
ARGS=()
take_flag() {
    local a found=1 rest=()
    for a in ${ARGS[@]+"${ARGS[@]}"}; do
        if [ "$a" = "$1" ]; then found=0; else rest+=("$a"); fi
    done
    ARGS=(${rest[@]+"${rest[@]}"})
    return $found
}

# need_hosts <option>: ARGS must hold at least one host.
need_hosts() { [ ${#ARGS[@]} -gt 0 ] || usage_error "$1 needs at least one host"; }

if [ -z "$host" ]; then
    while [ $# -gt 0 ]; do
        case $1 in
            --foreground|--verbose) export SAYPIPE_FOREGROUND=1; shift ;;
            *) break ;;
        esac
    done
fi

if [ -z "$host" ] && [ $# -gt 0 ] && [[ $1 == -* ]] && [ "$1" != -- ]; then
    op=$1; shift
    ARGS=("$@")
    case $op in
        --doctor)
            [ $# -eq 0 ] || usage_error "$op takes no arguments"
            doctor; exit "$?" ;;
        --version)
            [ $# -eq 0 ] || usage_error "$op takes no arguments"
            printf 'saypipe %s\n' "$VERSION"; exit 0 ;;
        -h|--help)
            [ $# -eq 0 ] || usage_error "$op takes no arguments"
            usage; exit 0 ;;
        --host-add|--gpu-add|--audio-add|--share-add|--link-add)
            take_flag --force && FORCE=1
            need_hosts "$op"
            case $op in
                --host-add)  host_add "${ARGS[@]}" ;;
                --gpu-add)   option_add gpu "${ARGS[@]}" ;;
                --audio-add) option_add audio "${ARGS[@]}" ;;
                --share-add) option_add share "${ARGS[@]}" ;;
                --link-add)  link_add "${ARGS[@]}" ;;
            esac ;;
        --host-remove|--gpu-remove|--audio-remove|--share-remove|--share-exit|\
        --link-remove|--alias-remove)
            need_hosts "$op"
            case $op in
                --host-remove)  host_remove "${ARGS[@]}" ;;
                --gpu-remove)   option_remove gpu "${ARGS[@]}" ;;
                --audio-remove) option_remove audio "${ARGS[@]}" ;;
                --share-remove) option_remove share "${ARGS[@]}" ;;
                --share-exit)   share_exit "${ARGS[@]}" ;;
                --link-remove)  link_remove "${ARGS[@]}" ;;
                --alias-remove) alias_remove "${ARGS[@]}" ;;
            esac ;;
        --alias-add)
            take_flag --force && FORCE=1
            [ ${#ARGS[@]} -eq 2 ] || usage_error "usage: $SELF --alias-add [--force] <alias> <host>"
            alias_add "${ARGS[0]}" "${ARGS[1]}" ;;
        --default-set)
            # options go before the host; everything after it is the command
            global=0
            while [ $# -gt 0 ]; do
                case $1 in --force) FORCE=1; shift ;; --global) global=1; shift ;; *) break ;; esac
            done
            if [ $global = 1 ]; then
                [ $# -ge 1 ] || usage_error "usage: $SELF --default-set --global <command...>"
                default_set '*' "$@"
            else
                [ $# -ge 2 ] || usage_error "usage: $SELF --default-set [--force] <host> <command...>"
                default_set "$@"
            fi ;;
        --default-remove)
            if take_flag --global; then
                [ ${#ARGS[@]} -eq 0 ] || usage_error "--default-remove --global takes no hosts"
                default_remove '*'
            else
                need_hosts "$op"
                default_remove "${ARGS[@]}"
            fi ;;
        --list)
            [ $# -le 1 ] || usage_error "--list takes at most one list name"
            list_cmd "${1:-}" ;;
        --probe)
            apply=0; take_flag --apply && apply=1
            need_hosts "$op"
            probe "$apply" "${ARGS[@]}" ;;
        --completion-hosts)
            [ $# -le 1 ] || usage_error "usage: $SELF --completion-hosts [all|enabled]"
            case ${1:-} in
                "")          echo "completion-hosts $(setting_get completion-hosts all)" ;;
                all|enabled) setting_set completion-hosts "$1" && echo "completion-hosts $1" ;;
                *)           usage_error "usage: $SELF --completion-hosts [all|enabled]" ;;
            esac ;;
        --complete)                       # internal, for completions/*
            complete_list "${1:-}" 2>/dev/null; exit 0 ;;
        *)
            usage_error "unknown option '$op'" ;;
    esac
    if [ "$LINKS_MADE" = 1 ]; then
        case ":$PATH:" in *":$LINK_DIR:"*) ;; *) echo "note: $LINK_DIR is not in PATH" >&2 ;; esac
    fi
    exit $mgmt_rc
fi

# ---- launch -----------------------------------------------------------------

# launch <host> <command...>: start the detached worker and watch it for
# SAYPIPE_WAIT seconds (default 2), so a launch that fails right away (ssh
# error, command not found) is reported here instead of only in ERROR_LOG.
launch() {
    local h=$1 status='' rc step=0.1 max n=0 launch_pid=''
    launch_cleanup() {
        if [ -n "$launch_pid" ]; then
            kill -TERM "$launch_pid" 2>/dev/null || true
            wait "$launch_pid" 2>/dev/null || true
        fi
        [ -z "$status" ] || rm -rf -- "$status"
    }
    trap launch_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    if [ "${SAYPIPE_FOREGROUND:-0}" = 1 ]; then
        "$0" --run "$@" & launch_pid=$!
        wait "$launch_pid"; rc=$?
        launch_pid=
        launch_cleanup
        trap - EXIT INT TERM HUP
        return "$rc"
    fi
    status=$(mktemp -d "${TMPDIR:-/tmp}/saypipe-status.XXXXXX") || {
        echo "$SELF: cannot create startup status directory" >&2
        launch_cleanup
        trap - EXIT INT TERM HUP
        return 1;
    }
    if ! SAYPIPE_STATUS=$status setsid -f "$0" --run "$@" </dev/null >/dev/null 2>&1; then
        SAYPIPE_STATUS=$status nohup "$0" --run "$@" </dev/null >/dev/null 2>&1 &
    fi
    sleep "$step" 2>/dev/null || step=1
    max=$(awk -v w="${SAYPIPE_WAIT:-2}" -v s="$step" 'BEGIN { printf "%d", w / s }')
    while [ "$n" -lt "$max" ] && [ ! -s "$status/finished" ]; do sleep "$step"; n=$((n + 1)); done
    rc=0
    if [ -s "$status/finished" ]; then
        rc=$(head -n 1 "$status/finished")
        if [ "$rc" != 0 ]; then
            printf '%s: %s on %s failed (exit %s):\n' "$SELF" "${*:2}" "$h" "$rc" >&2
            tail -n +2 "$status/finished" | sed 's/^/  /' >&2
        fi
    elif [ ! -s "$status/started" ]; then
        echo "$SELF: detached worker did not start; try --foreground" >&2
        rc=1
    fi
    launch_cleanup
    trap - EXIT INT TERM HUP
    return "$rc"
}

if [ -z "$host" ]; then
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || usage_error "no host given (usage: $SELF [--] <host> [<command...>])"
    host=$1; shift
    check_host "$host" || exit 2
fi
[ "${1:-}" = -- ] && shift
# An alias (from a link or the command line) stands for its real host.
if t=$(alias_target "$host"); then host=$t; fi
# No command: run the host's default, else the global default.
if [ $# -eq 0 ]; then
    if c=$(default_cmd "$host") || c=$(default_cmd '*'); then
        set -- "$c"
    else
        echo "$SELF: no command given for $host (set a default with" \
             "'$SELF --default-set $host <command>' or '$SELF --default-set --global <command>')" >&2
        exit 1
    fi
fi
launch "$host" "$@"
exit $?
